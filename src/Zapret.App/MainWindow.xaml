<Window x:Class="Zapret.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Control" Height="780" Width="1200" MinHeight="640" MinWidth="1000"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,18">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="Z" FontSize="19" FontWeight="Bold" Foreground="#08120B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ZAPRET" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="CONTROL" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Остановлено" Margin="8,0,0,0"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="StatusStrategy" Text="стратегия не выбрана" Margin="0,6,0,0"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusExtra" Text="" Margin="0,2,0,0" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button x:Name="ToggleRunButton" Content="Запустить" Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,0" Click="ToggleRun_Click" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" x:Name="NavPanel">
                    <ToggleButton x:Name="NavStrategies" Style="{StaticResource NavButton}" Content="Стратегии"
                                  Tag="strategies" IsChecked="True" Click="Nav_Click" />
                    <ToggleButton x:Name="NavTest" Style="{StaticResource NavButton}" Content="Подбор и тест"
                                  Tag="test" Click="Nav_Click" />
                    <ToggleButton x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Content="Диагностика"
                                  Tag="diagnostics" Click="Nav_Click" />
                    <ToggleButton x:Name="NavLists" Style="{StaticResource NavButton}" Content="Списки и фильтры"
                                  Tag="lists" Click="Nav_Click" />
                    <ToggleButton x:Name="NavUpdate" Style="{StaticResource NavButton}" Content="Обновления"
                                  Tag="update" Click="Nav_Click" />
                    <ToggleButton x:Name="NavGuide" Style="{StaticResource NavButton}" Content="Инструкция"
                                  Tag="guide" Click="Nav_Click" />
                    <ToggleButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Настройки"
                                  Tag="settings" Click="Nav_Click" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Button Content="Журнал winws" Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Stretch" Click="OpenLog_Click" />
                    <TextBlock x:Name="VersionText" Text="Zapret Control 1.0.0" Margin="2,10,0,0"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="ContentHost" Margin="24,18,24,8" />

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="24,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterText" Text="Готово" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="FooterService" Text="" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" />
                        <Button Content="Папка zapret" Style="{StaticResource SmallButton}"
                                Click="OpenFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
