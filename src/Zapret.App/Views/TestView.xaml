<UserControl x:Class="Zapret.App.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Подбор рабочей стратегии" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Приложение по очереди запускает стратегии и проверяет реальные соединения с Discord, YouTube и другими сайтами. В конце выберите лучшую и запустите её." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Проверяемые сервисы" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,8"
                                   Text="Без галочки сервис не участвует в оценке." />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TargetsPanel" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox x:Name="DpiCheck" Content="Проверка блока 16-20 КБ"
                                  Checked="DpiCheck_Changed" Unchecked="DpiCheck_Changed" />
                        <CheckBox x:Name="UdpCheck" Content="Проверка UDP (голос Discord)"
                                  Checked="DpiCheck_Changed" Unchecked="DpiCheck_Changed" />
                        <CheckBox x:Name="MediaCheck" Content="Загрузка видео YouTube"
                                  Checked="DpiCheck_Changed" Unchecked="DpiCheck_Changed" />
                        <CheckBox x:Name="AllStrategiesCheck" Content="Все стратегии (долго)" IsChecked="True" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                   Text="Полный перебор 22 стратегий занимает несколько минут." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FindBestButton" Content="Найти лучшую" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0" Click="FindBest_Click" />
                            <Button x:Name="TestCurrentButton" Content="Проверить выбранную" Style="{StaticResource ButtonBase}"
                                    Margin="0,0,8,0" Click="TestCurrent_Click" />
                            <Button x:Name="CancelButton" Content="Стоп" Style="{StaticResource DangerButton}"
                                    IsEnabled="False" Click="Cancel_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ApplyBestButton" Content="Запустить лучшую" Style="{StaticResource ButtonBase}"
                                    IsEnabled="False" Click="ApplyBest_Click" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,10">
                        <ProgressBar x:Name="Progress" Height="6" />
                        <TextBlock x:Name="StageText" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"
                                   Text="Готово к проверке." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0"
                                   Text="Оценка выше - лучше: 100 за проверку, минус 100 за отказ, штраф за блок 16-20 КБ, +80 за UDP, +100 за видео, до +40 за отклик. «Качество» - процент от максимума. Сверху идут стратегии без ошибок и блокировок." />
                    </StackPanel>

                    <DataGrid x:Name="ResultsGrid" Grid.Row="2" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Стратегия" Binding="{Binding Name}" Width="115" />
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Score}" Width="65" />
                            <DataGridTextColumn Binding="{Binding Quality}" Width="60">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Кач." ToolTip="Качество: процент от максимума при текущем наборе проверок" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Errors}" Width="55">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Ош." ToolTip="Количество проваленных проверок" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Вердикт" Binding="{Binding Verdict}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Verdict}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Детали" Binding="{Binding Detail}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Detail}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Expander Grid.Row="3" Header="Журнал проверки" Foreground="{StaticResource MutedBrush}"
                              Margin="0,10,0,0" IsExpanded="False">
                        <TextBox x:Name="LogBox" Style="{StaticResource Input}" Height="120" Margin="0,6,0,0"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
