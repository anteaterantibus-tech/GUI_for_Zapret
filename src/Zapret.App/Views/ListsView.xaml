<UserControl x:Class="Zapret.App.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Списки и фильтры" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Мои списки обновление не трогает. Списки сборки при обновлении объединяются с новыми." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Мои списки" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="2,0,0,4" />
                        <RadioButton x:Name="MyGeneralUserRadio" Content="list-general-user.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />
                        <RadioButton x:Name="MyExcludeUserRadio" Content="list-exclude-user.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />
                        <RadioButton x:Name="MyIpSetExcludeUserRadio" Content="ipset-exclude-user.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />

                        <TextBlock Text="Списки сборки" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="2,12,0,4" />
                        <RadioButton x:Name="BuildGeneralRadio" Content="list-general.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />
                        <RadioButton x:Name="BuildGoogleRadio" Content="list-google.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />
                        <RadioButton x:Name="BuildExcludeRadio" Content="list-exclude.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />
                        <RadioButton x:Name="BuildIpSetExcludeRadio" Content="ipset-exclude.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged" />
                        <RadioButton x:Name="BuildIpSetAllRadio" Content="ipset-all.txt" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged"
                                     ToolTip="Режим IPSet: только просмотр" />
                        <RadioButton x:Name="BuildIpSetBackupRadio" Content="ipset-all.txt.backup" GroupName="listfile"
                                     FontSize="11.5" Margin="0,2" Checked="FileSelectionChanged"
                                     ToolTip="Полный список подсетей: только просмотр" />

                        <TextBlock Text="ipset-all: только просмотр, режим меняется кнопками IPSet."
                                   Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                                   Margin="2,10,0,0" />
                        <Button x:Name="ImportFilesButton" Content="Загрузить файлы..."
                                Style="{StaticResource SmallButton}" Margin="2,10,0,0" HorizontalAlignment="Left"
                                Click="ImportFiles_Click"
                                ToolTip="Выбрать txt-файлы списков и объединить с текущими" />
                        <Button x:Name="ImportFolderButton" Content="Загрузить папку..."
                                Style="{StaticResource SmallButton}" Margin="2,6,0,0" HorizontalAlignment="Left"
                                Click="ImportFolder_Click"
                                ToolTip="Взять все файлы списков из папки" />
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="EditorHint" Style="{StaticResource Muted}" FontSize="11"
                                   TextWrapping="Wrap" />

                        <TextBox x:Name="EditorBox" Grid.Row="1" Style="{StaticResource Input}" Margin="0,8,0,8"
                                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DomainBox" Style="{StaticResource Input}" Margin="0,0,8,0"
                                     ToolTip="Домен или IP, который нужно добавить в выбранный список" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Добавить" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                        Click="AddDomain_Click" />
                                <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                        Click="Save_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Файл hosts" Style="{StaticResource H2}" />
                            <TextBlock x:Name="HostsStatusText" Grid.Column="1" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="HostsUpdateButton" Content="Обновить hosts"
                                    Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="HostsUpdate_Click" />
                            <Button Content="Убрать записи" Style="{StaticResource SmallButton}"
                                    Click="HostsRemove_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GameFilter" Style="{StaticResource H2}" />
                            <TextBlock x:Name="GameFilterStatusText" Grid.Column="1" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" FontSize="11" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="GameFilterToggleButton" Content="Включить GameFilter"
                                    Style="{StaticResource PrimaryButton}" Padding="10,6" Click="GameFilterToggle_Click" />
                            <ComboBox x:Name="GameFilterModeBox" Grid.Column="2" Width="120" Height="30">
                                <ComboBoxItem Content="Выключен" Tag="disabled" />
                                <ComboBoxItem Content="TCP и UDP" Tag="all" />
                                <ComboBoxItem Content="Только TCP" Tag="tcp" />
                                <ComboBoxItem Content="Только UDP" Tag="udp" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TCP" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            <TextBox x:Name="TcpPortsBox" Grid.Column="1" Style="{StaticResource Input}" Margin="6,0,0,0"
                                     ToolTip="Например 1024-65535" />
                            <TextBlock Text="UDP" Grid.Column="3" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            <TextBox x:Name="UdpPortsBox" Grid.Column="4" Style="{StaticResource Input}" Margin="6,0,0,0"
                                     ToolTip="Например 1024-65535" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Применить" Style="{StaticResource SmallButton}" Click="ApplyGameFilter_Click" />
                            <TextBlock x:Name="GameFilterHint" Grid.Column="1" Style="{StaticResource Muted}"
                                       FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IPSet" Style="{StaticResource H2}" />
                            <TextBlock x:Name="IpStatusText" Grid.Column="1" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton x:Name="IpNoneRadio" Content="none" GroupName="ipset" Margin="0,0,10,0"
                                         ToolTip="Обход только по доменам из списков" />
                            <RadioButton x:Name="IpAnyRadio" Content="any" GroupName="ipset" Margin="0,0,10,0"
                                         ToolTip="Обход всех адресов" />
                            <RadioButton x:Name="IpLoadedRadio" Content="loaded" GroupName="ipset"
                                         ToolTip="Список подсетей из репозитория" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Применить" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                    Click="ApplyIpSet_Click" />
                            <Button x:Name="UpdateIpSetButton" Content="Обновить IPSet"
                                    Style="{StaticResource SmallButton}" Click="UpdateIpSet_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="YouTube и обход" Style="{StaticResource H2}" />
                            <TextBlock x:Name="YouTubeStatusText" Grid.Column="1" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="YouTubeExcludeButton" Content="Не обходить"
                                    Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="YouTubeExclude_Click"
                                    ToolTip="Убрать YouTube из обхода, Discord останется" />
                            <Button x:Name="YouTubeIncludeButton" Content="Вернуть обход"
                                    Style="{StaticResource SmallButton}" Click="YouTubeInclude_Click"
                                    ToolTip="Восстановить list-google и убрать исключения" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Discord: текст и сайт" Style="{StaticResource H2}" />
                            <TextBlock x:Name="DiscordStatusText" Grid.Column="1" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock x:Name="DiscordHint" Style="{StaticResource Muted}" FontSize="10"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Голосовой UDP-профиль работает по портам, поэтому остаётся." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="DiscordExcludeButton" Content="Не обходить"
                                    Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="DiscordExclude_Click"
                                    ToolTip="Убрать домены Discord из обхода (текст и сайт)" />
                            <Button x:Name="DiscordIncludeButton" Content="Вернуть обход"
                                    Style="{StaticResource SmallButton}" Click="DiscordInclude_Click"
                                    ToolTip="Восстановить списки Discord" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
