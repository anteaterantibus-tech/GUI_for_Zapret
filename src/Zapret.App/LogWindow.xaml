<Window x:Class="Zapret.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал winws" Height="520" Width="860" MinHeight="360" MinWidth="600"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Журнал winws" Style="{StaticResource H2}" />
                <TextBlock x:Name="LogPathText" Style="{StaticResource Mono}" FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Открыть папку логов" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                        Click="OpenFolder_Click" />
                <Button Content="Очистить" Style="{StaticResource SmallButton}" Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource Input}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />

        <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"
                   Text="winws пишет сюда только при включённом --debug; строка запуска и код выхода логируются всегда." />
    </Grid>
</Window>
